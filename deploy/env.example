# Copiar a deploy/.env y rellenar. NO comitear deploy/.env (va en .gitignore).

# Postgres (contenedor interno)
POSTGRES_USER=argentum
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=argentum_prod

# Secreto de Phoenix. Generar con:
#   podman run --rm aomania-lambda:latest bin/argentum eval "IO.puts(:crypto.strong_rand_bytes(48) |> Base.encode64())"
# o con `mix phx.gen.secret` si tienes el toolchain.
SECRET_KEY_BASE=cambia-esto-64-bytes-base64

# Host público por el que sirve la app (nombre Tailscale del Corsair).
PHX_HOST=corsair.tailc48014.ts.net
